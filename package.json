{
  "name": "clarity",
  "type": "module",
  "version": "3.6.4",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "homepage": "https://github.com/L33Z22L11/blog-v3",
  "engines": {
    "node": ">=22.15",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "pnpm clean && nuxt prepare",
    "clean": "rimraf .nuxt .data node_modules/.cache",
    "dev": "nuxt dev --open",
    "dev:clean": "pnpm clean && nuxt dev --open",
    "dev:host": "nuxt dev --host",
    "optimize:images": "node scripts/optimize-images.js",
    "prebuild": "pnpm optimize:images",
    "pregenerate": "pnpm optimize:images",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "bump": "pnpx taze -w && rimraf pnpm-lock.yaml && pnpm update && pnpm dedupe",
    "lint": "eslint && stylelint '**/*.{vue,scss}'",
    "lint:fix": "eslint --fix && stylelint '**/*.{vue,scss}' --fix",
    "init-project": "tsx scripts/init-project",
    "new": "tsx scripts/new-blog",
    "new:weekly": "tsx scripts/new-weekly"
  },
  "dependencies": {
    "@bikariya/image-viewer": "catalog:ui",
    "@bikariya/modals": "catalog:ui",
    "@bikariya/shiki": "catalog:content",
    "@nuxt/content": "catalog:content",
    "@nuxt/icon": "catalog:ui",
    "@nuxt/image": "catalog:ui",
    "@nuxtjs/color-mode": "catalog:ui",
    "@nuxtjs/seo": "catalog:content",
    "@pinia/nuxt": "catalog:util",
    "@shikijs/colorized-brackets": "catalog:content",
    "@shikijs/transformers": "catalog:content",
    "@vueuse/core": "catalog:util",
    "@vueuse/nuxt": "catalog:util",
    "@vueuse/router": "catalog:util",
    "abcjs": "catalog:content",
    "ci-info": "catalog:framework",
    "embla-carousel-autoplay": "catalog:ui",
    "embla-carousel-vue": "catalog:ui",
    "embla-carousel-wheel-gestures": "catalog:ui",
    "minisearch": "catalog:util",
    "nuxt": "catalog:framework",
    "parse-domain": "catalog:util",
    "plain-shiki": "catalog:content",
    "radash": "catalog:util",
    "shiki": "catalog:content",
    "site-config-stack": "catalog:util",
    "temporal-polyfill": "catalog:util",
    "vue": "catalog:framework",
    "vue-router": "catalog:framework",
    "vue-tippy": "catalog:ui",
    "web-vitals": "^6.2.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:quality",
    "@clack/prompts": "catalog:util",
    "@iconify-json/catppuccin": "catalog:ui",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/ph": "catalog:ui",
    "@iconify-json/ri": "catalog:ui",
    "@iconify-json/simple-icons": "catalog:ui",
    "@iconify-json/solar": "catalog:ui",
    "@nuxt/a11y": "catalog:quality",
    "@nuxt/hints": "catalog:quality",
    "@zinkawaii/stylelint-config": "catalog:quality",
    "cspell": "catalog:quality",
    "eslint": "catalog:quality",
    "fast-xml-parser": "catalog:util",
    "nuxt-llms": "catalog:content",
    "oxc-minify": "catalog:util",
    "p-limit": "catalog:util",
    "rehype-katex": "catalog:content",
    "remark-math": "catalog:content",
    "remark-reading-time": "catalog:content",
    "rimraf": "catalog:util",
    "sass-embedded": "catalog:framework",
    "sharp": "^0.35.4",
    "strip-ansi": "catalog:util",
    "stylelint": "catalog:quality",
    "tsx": "catalog:framework",
    "typescript": "catalog:framework",
    "unplugin-yaml": "catalog:framework"
  }
